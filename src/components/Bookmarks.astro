<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste any link — with or without <code>https://</code> — to generate a short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { createUniqueSlug, formatBookmark, normalizeUrl, parseBookmarks } from './bookmarkHelpers';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  function loadBookmarks() {
    try {
      return parseBookmarks(localStorage.getItem(storageKey));
    } catch {
      return [];
    }
  }

  let bookmarks = loadBookmarks();

  function saveBookmarks() {
    try {
      localStorage.setItem(storageKey, JSON.stringify(bookmarks));
    } catch {
      // Storage can be unavailable or full; the in-memory list remains usable.
    }
  }

  function render() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const details = document.createElement('span');
      details.className = 'bookmark-details';
      details.textContent = ` :: ${bookmark.slug}`;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        }
      });

      item.append(link, details, copy);
      item.setAttribute('aria-label', formatBookmark(bookmark));
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement)) return;

    const url = normalizeUrl(input.value);
    if (!url) {
      input.focus();
      return;
    }

    const bookmark = { url, slug: createUniqueSlug(bookmarks) };
    bookmarks = [...bookmarks, bookmark];
    saveBookmarks();
    input.value = '';
    render();
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(storageKey);
    } catch {
      // Storage can be unavailable; the in-memory list is still cleared.
    }
    render();
  });

  render();
</script>

<style>
  .bookmark-details {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .bookmark .url {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }
  .bookmark .copy {
    margin-left: auto;
  }
</style>
